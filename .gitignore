.DS_Store

# Local credentials and virtualenvs
.env
.env.*
!.env.example
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]

# Local product inputs and generated outputs. Keep the folders, not contents.
incoming/*
!incoming/.gitkeep
outputs/*
!outputs/.gitkeep

# Store-specific backdrop templates. Keep the folder, not local assets.
backdrops/*
!backdrops/.gitkeep
