# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=your_anthropic_api_key

# Photoroom (https://www.photoroom.com/api) — for white-bg ecommerce cleanup
PHOTOROOM_API_KEY=your_photoroom_api_key
BACKGROUND_REMOVER=photoroom

# OpenAI — for the reference-conditioned on-model shot (gpt-image-1 edits).
# This is the image-gen provider; Claude does NOT generate images.
OPENAI_API_KEY=your_openai_api_key

# Shopify Admin API — per-client Dev Dashboard app credentials.
# For each Shopify store/client, copy this file to .env and fill that store's
# values. Never commit .env.
# Get Client ID + Client secret from: Dev Dashboard -> your app -> Settings.
# We exchange them for a 24h Admin token at runtime; no static shpat_ token,
# no app install needed. App + store must be in the same Shopify org.
SHOPIFY_STORE=example.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_API_VERSION=2026-04
